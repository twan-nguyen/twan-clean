{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ available of %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ available of %2$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Còn trống %@ trên tổng %@"
          }
        }
      }
    },
    "%@ is running" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ đang chạy"
          }
        }
      }
    },
    "%@ selected" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã chọn %@"
          }
        }
      }
    },
    "%lld caches, logs and temporary items. Apps recreate them when needed." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld mục cache, log và tệp tạm. Ứng dụng sẽ tự tạo lại khi cần."
          }
        }
      }
    },
    "%lld items could not be removed without more access" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld mục cần thêm quyền mới xoá được"
          }
        }
      }
    },
    "%lld items failed" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld mục thất bại"
          }
        }
