    },
    "macOS needs your approval in Login Items." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS cần bạn cho phép trong Mục đăng nhập."
          }
        }
      }
