      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twan Clean"
          }
        }
      }
    },
    "Twan Clean can only uninstall apps in the Applications folder." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twan Clean chỉ gỡ được app nằm trong thư mục Applications."
          }
        }
      }
    },
    "Twan Clean compares caches, logs and saved states with the apps installed now. Nothing is selected for you, and removed files go to the Trash." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twan Clean so cache, log và trạng thái đã lưu với các app đang cài. Không mục nào được chọn sẵn, và tệp bị xoá sẽ vào Thùng rác."
          }
        }
      }
    },
    "Twan Clean could not read %lld locations. Give it Full Disk Access to see everything, then scan again." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twan Clean không đọc được %lld vị trí. Hãy cấp quyền truy cập toàn ổ đĩa để thấy đầy đủ, rồi quét lại."
          }
        }
      }
    },
    "Twan Clean needs to quit it first. Unsaved changes in the app may be lost if you force it to quit." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twan Clean cần thoát app trước. Nếu buộc thoát, các thay đổi chưa lưu trong app có thể bị mất."
          }
        }
      }
    },
    "Twan Clean needs your password to remove the selected items." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twan Clean cần mật khẩu của bạn để xoá các mục đã chọn."
          }
        }
      }
    },
    "Twan Clean needs your password to stop the app's background services." : {
      "localizations" : {
