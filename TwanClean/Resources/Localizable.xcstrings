        }
      }
    },
    "Also files named after the developer. May include files of the developer's other apps, which are never selected for you." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm cả tệp đặt theo tên nhà phát triển. Có thể gồm tệp của các app khác cùng nhà phát triển; những tệp này không bao giờ được chọn sẵn."
          }
        }
      }
    },
    "Also files whose names contain the app's name or identifier. Recommended." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
