      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã xoá %lld mục"
          }
        }
      }
    },
    "%lld items you can still restore from the Trash. Space is freed when you empty it." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld mục vẫn khôi phục được từ Thùng rác. Dung lượng được giải phóng khi bạn dọn Thùng rác."
          }
        }
      }
    },
    "%lld months" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld tháng"
          }
        }
      }
    },
    "%lld smaller items" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld mục nhỏ hơn"
