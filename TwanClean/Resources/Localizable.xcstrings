{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ available of %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ available of %2$@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Còn trống %@ trên tổng %@"
          }
        }
      }
    },
    "%@ goes to the Trash. Restorable until you empty it." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ sẽ vào Thùng rác. Khôi phục được cho tới khi dọn Thùng rác."
          }
        }
      }
    },
    "%@ is a link to another app. Uninstall the original app instead." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ là liên kết tới một app khác. Hãy gỡ app gốc thay vào đó."
          }
        }
      }
    },
    "%@ is part of macOS or protected, so Twan Clean cannot uninstall it." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ là một phần của macOS hoặc được bảo vệ, nên Twan Clean không thể gỡ."
          }
        }
      }
    },
