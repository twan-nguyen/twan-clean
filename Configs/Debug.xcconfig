// Debug signs ad-hoc by default so a fresh clone builds without an Apple ID.
// Copy Local.xcconfig.example to Local.xcconfig and set your Personal Team:
// an "Apple Development" signature keeps the Full Disk Access grant stable
// across rebuilds, while an ad-hoc signature loses it on every build.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
ENABLE_HARDENED_RUNTIME = NO

#include? "Local.xcconfig"
